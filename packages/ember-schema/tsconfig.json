{
  "extends": "@ember/app-tsconfig",
  "include": ["src/**/*", "unpublished-development-types/**/*"],
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@ember-schema-app/ember-schema/*": ["./src/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["ember-source/types", "@glint/ember-tsc/types"]
  }
}
