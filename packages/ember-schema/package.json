{
  "name": "@ember-schema-app/ember-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-aware Ember components and service contracts.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.cjs": "./addon-main.cjs",
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:declarations && rollup --config",
    "build:declarations": "node build-declarations.mjs",
    "lint": "eslint src",
    "test": "pnpm run typecheck",
    "typecheck": "ember-tsc --noEmit"
  },
  "dependencies": {
    "@ember-schema-app/schema": "workspace:*",
    "@ember-schema-app/ember-ui": "workspace:*",
    "@embroider/addon-shim": "^1.10.3",
    "decorator-transforms": "^2.3.1",
    "ember-inflector": "^6.0.0",
    "lodash-es": "4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.0.0",
    "@warp-drive/core": "5.8.2",
    "@warp-drive/legacy": "5.8.2",
    "ember-source": ">=6.7.0",
    "true-myth": "^9.4.0"
  },
  "ember-addon": {}
}
