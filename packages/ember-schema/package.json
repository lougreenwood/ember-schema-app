{
  "name": "@ember-schema-app/ember-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-aware Ember components and service contracts.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.cjs": "./addon-main.cjs",
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:declarations && rollup --config",
    "build:declarations": "node build-declarations.mjs",
    "lint": "eslint src",
    "test": "pnpm run typecheck",
    "typecheck": "ember-tsc --noEmit"
  },
  "dependencies": {
