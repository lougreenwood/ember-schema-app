{
  "name": "@ember-schema/ember",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-aware Ember components and service contracts.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.cjs": "./addon-main.cjs",
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:declarations && rollup --config",
    "build:declarations": "node build-declarations.mjs",
    "lint": "eslint src",
    "test": "pnpm run typecheck",
    "typecheck": "ember-tsc --noEmit"
  },
  "dependencies": {
    "@ember-schema/schema": "workspace:*",
    "@ember-schema/ui": "workspace:*",
    "@embroider/addon-shim": "^1.10.3",
    "decorator-transforms": "^2.3.1"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.0.0",
    "ember-source": ">=6.7.0",
    "true-myth": "^9.4.0"
  },
  "ember-addon": {
    "app-js": {
      "./components/schema-probe.js": "./dist/_app_/components/schema-probe.js",
      "./services/schema-display-info.js": "./dist/_app_/services/schema-display-info.js",
      "./services/schema-display-info/base.js": "./dist/_app_/services/schema-display-info/base.js"
    }
  }
}
