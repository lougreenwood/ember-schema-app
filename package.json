{
  "name": "ember-schema-app",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @ember-schema/schema build && pnpm --filter @ember-schema/ui build && pnpm --filter @ember-schema/ember build && pnpm --filter demo build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test": "pnpm --filter @ember-schema/schema test && pnpm --filter demo test",
    "typecheck": "pnpm --filter @ember-schema/schema typecheck && pnpm --filter @ember-schema/ui typecheck && pnpm --filter @ember-schema/ember typecheck && pnpm --filter demo typecheck"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@ember/app-tsconfig": "^1.0.3",
    "@ember/library-tsconfig": "^1.0.3",
    "@ember/test-helpers": "^5.2.2",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.13",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.19.7",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.5.2",
    "@eslint/js": "^9.39.2",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.1.1",
    "true-myth": "9.4.0",
    "@glint/template": "^1.7.4",
    "@glint/tsserver-plugin": "^2.1.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/qunit": "^2.19.13",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.1",
    "decorator-transforms": "^2.3.1",
    "ember-cli": "~6.11.0",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.1.1",
    "ember-source": "~6.11.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "rollup": "^4.22.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "testem": "^3.17.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.1"
  }
}
